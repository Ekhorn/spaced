{
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": ["docs"]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-window",
        "no-window-prefix",
        "jsx-no-children-prop",
        "jsx-button-has-type"
      ]
    }
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.1.2",
    "slate-solid": "./srcs/slate-solid/index.ts",
    "slate-yjs-solid": "./srcs/slate-yjs-solid/index.ts",
    "types": "./srcs/types/index.ts"
  }
}
